{
  "name": "@turbopress-de/cli",
  "version": "0.4.0",
  "description": "Command-line client for the turbopress Hosting API",
  "license": "MIT",
  "author": "turbopress",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/turbopress-de/turbopress-cli.git"
  },
  "homepage": "https://github.com/turbopress-de/turbopress-cli#readme",
  "bugs": {
    "url": "https://github.com/turbopress-de/turbopress-cli/issues"
  },
  "keywords": [
    "turbopress",
    "cli",
    "hosting",
    "wordpress",
    "deployment",
    "api"
  ],
  "type": "module",
  "bin": {
    "turbopress": "dist/bin.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
